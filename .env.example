# Copy to .env and fill in. Standard Postgres connection string — works with either
# a Supabase Postgres or a self-hosted Postgres (ADR-001 / ADR-014 portability).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local dev against the Docker Postgres used during testing:
# DATABASE_URL=postgresql://postgres:darsi@localhost:5433/darsi

# CORS: comma-separated list of allowed WebView origins. Default (unset) = "*",
# fine for local dev, NOT for production — /api/presence is a write endpoint.
# Origin = scheme+host only, NO trailing slash, NO spaces around commas.
# Produksi (Railway) WAJIB set ini ke origin WebView Vercel:
# CORS_ORIGINS=https://darsi-indoor-navigation.vercel.app

POI_SYNC_TOKEN=change-me

# Bifrost adalah provider LLM UTAMA untuk endpoint asisten
# (POST /api/assistant/query) — gateway OpenAI-compatible eksternal (hcm-lab.id,
# GPU sungguhan, dikelola tim PSDKU/HCM), BUKAN service di docker-compose ini.
# Auth pakai header "x-api-key" (beda dari Groq yang "Authorization: Bearer").
# JANGAN PERNAH commit key sungguhan ke sini atau ke git manapun — isi hanya di
# .env lokal/gitignored, sama seperti pola groq-api-key.local.txt di repo Unity.
BIFROST_API_KEY=
# BIFROST_URL=https://bifrost.hcm-lab.id/v1/chat/completions
# BIFROST_MODEL=llama.cpp/medgemma-1.5-4b-it-q4

# Groq API key untuk FALLBACK endpoint asisten, dipakai kalau Bifrost gagal/
# timeout/kosong. Dipanggil dari SERVER, bukan dari APK — ini yang menutup utang
# keamanan yang tercatat di OllamaConnector.cs (key ikut ter-bundle ke APK kalau
# dipanggil dari client). Boleh kosong (Bifrost tetap jalan sendiri), tapi
# endpoint jadi rentan kalau Bifrost juga gagal.
GROQ_API_KEY=

# Opsional, hanya untuk menjalankan test yang butuh DB sungguhan.
# Kalau kosong, test tersebut di-skip (bukan gagal).
TEST_DATABASE_URL=

