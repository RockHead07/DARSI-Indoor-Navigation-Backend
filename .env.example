# Copy to .env and fill in. Standard Postgres connection string — works with either
# a Supabase Postgres or a self-hosted Postgres (ADR-001 / ADR-014 portability).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local dev against the Docker Postgres used during testing:
# DATABASE_URL=postgresql://postgres:darsi@localhost:5433/darsi

# CORS: comma-separated list of allowed WebView origins. Default (unset) = "*",
# fine for local dev, NOT for production — /api/presence is a write endpoint.
# Origin = scheme+host only, NO trailing slash, NO spaces around commas.
# Produksi (Railway) WAJIB set ini ke origin WebView Vercel:
# CORS_ORIGINS=https://darsi-indoor-navigation.vercel.app

POI_SYNC_TOKEN=change-me

# Qwen lokal (Ollama) adalah provider UTAMA untuk endpoint asisten
# (POST /api/assistant/query) — jalan sebagai service Docker terpisah, satu
# network dengan api, lihat docker-compose.yml. Tidak butuh API key.
# Kosongkan/biarkan default kalau pakai docker-compose (nama service "ollama"
# otomatis ter-resolve). Set manual hanya kalau setup jaringan Docker-mu beda.
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:7b

# Groq API key untuk FALLBACK endpoint asisten, dipakai kalau Qwen lokal gagal/
# timeout/model belum ditarik. Dipanggil dari SERVER, bukan dari APK — ini yang
# menutup utang keamanan yang tercatat di OllamaConnector.cs (key ikut ter-bundle
# ke APK kalau dipanggil dari client). Boleh kosong (Qwen tetap jalan sendiri),
# tapi endpoint jadi rentan kalau Qwen juga gagal.
GROQ_API_KEY=

# Opsional, hanya untuk menjalankan test yang butuh DB sungguhan.
# Kalau kosong, test tersebut di-skip (bukan gagal).
TEST_DATABASE_URL=

