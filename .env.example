# ==============================================================================
# DARSI Backend (RAG & POI Indoor Navigation) - Environment Configuration Template
# ==============================================================================

# Port host untuk API FastAPI (ADR-027 Amandemen 027-B)
# Menggunakan port 8050 agar tidak bertabrakan dengan DARSI-CS di port 8000
API_PORT=8050

# Port host untuk Database PostgreSQL (pgvector)
# Menggunakan port 5433 agar tidak bertabrakan dengan PostgreSQL default (5432)
DB_PORT=5433

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=darsi
POSTGRES_DB=darsi

# Token Sinkronisasi POI dari Unity Editor (T3.4-L2)
POI_SYNC_TOKEN=darsi-admin-token

# LLM Providers (ADR-029)
# Bifrost (medgemma via hcm-lab.id) adalah provider primer
BIFROST_API_KEY=
# Groq (Llama 3.3 70B) adalah fallback otomatis saat Bifrost gagal/timeout
GROQ_API_KEY=

# CORS Configuration
CORS_ORIGINS=*

# TTS Output Base URL (opsional, kosongkan jika disajikan dari root yang sama)
TTS_BASE_URL=
